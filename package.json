{
  "name": "sakura-note",
  "version": "1.0.0",
  "description": "A bilingual Astro 7 blog theme with Cloudflare Workers, D1, KV, R2 and Images.",
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "cloudflare",
    "workers",
    "d1",
    "kv",
    "r2",
    "bilingual"
  ],
  "homepage": "https://github.com/arleycn/sakura-note#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arleycn/sakura-note.git"
  },
  "bugs": "https://github.com/arleycn/sakura-note/issues",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply sakura-note-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply sakura-note-db --local",
    "og": "node tools/make-og.mjs",
    "smoke": "node tools/smoke.mjs",
    "smoke:i18n": "node tools/i18n-smoke.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "puppeteer-core": "^25.17.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.163.0"
  }
}
