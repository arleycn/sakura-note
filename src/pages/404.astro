---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面走丢了" description="404 · 这个页面不存在" noindex>
  <div class="wrap page" style="padding-top: calc(var(--nav-h) + 80px); text-align: center">
    <p style="font-size:64px;line-height:1" aria-hidden="true">🌸🍃</p>
    <h1
      style="font-family:var(--font-disp);font-size:clamp(28px,5vw,40px);margin-top:14px"
    >
      这页被风吹走了
    </h1>
    <p style="color:var(--muted);margin-top:10px">
      404 · 你要找的页面不存在，可能已经改名或删除。
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/">回首页 🏠</a>
      <a class="btn btn--ghost" href="/archives">看归档 🗂️</a>
    </div>
  </div>
</BaseLayout>
