---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { MY_SITES, SITE } from '../config';

const stack = [
  { layer: '框架', value: 'Astro 7.4 · 内容集合 + 按需渲染', emoji: '🚀' },
  { layer: '部署', value: 'Cloudflare Workers + Static Assets', emoji: '☁️' },
  { layer: '评论', value: 'D1 存正文，Actions 做接口', emoji: '💬' },
  { layer: '计数', value: 'KV 记阅读量，Cookie 去重', emoji: '👀' },
  { layer: '图片', value: 'R2 存配图，Images binding 做变换', emoji: '🖼️' },
  { layer: '交互', value: 'ClientRouter + Actions（官方 ajax）', emoji: '⚡' },
];

const contacts = [
  { label: 'GitHub', hint: 'arleycn', href: SITE.github, emoji: '🐙' },
  { label: 'Telegram', hint: '@Leoniceee', href: SITE.telegram, emoji: '✈️' },
  { label: '邮箱', hint: SITE.email, href: `mailto:${SITE.email}`, emoji: '📮' },
];
---

<BaseLayout title="关于" description={`关于 ${SITE.author} 与这个博客，以及我做的其他站点。`}>
  <div class="wrap page about" style="padding-top: calc(var(--nav-h) + 40px); max-width: 880px">
    <div class="ch-head" style="margin-top:0">
      <span class="ch-badge" aria-hidden="true">🍡</span>
      <h1 class="ch-title">关于</h1>
      <span class="ch-line"></span>
    </div>

    <section class="panel about-me">
      <img
        class="about-avatar"
        src="/img/avatar.webp"
        alt={`${SITE.author} 的头像`}
        width="88"
        height="88"
        loading="eager"
        decoding="async"
      />
      <div>
        <p class="about-name">{SITE.author}</p>
        <p class="about-tag">{SITE.tagline}</p>
      </div>
    </section>

    <section class="panel">
      <h2>🌸 这是哪儿</h2>
      <p>
        {SITE.name}（{SITE.theme}），{SITE.since} 年开写。
        记录所得，分享所获 —— 技术教程、二次元、资源整理，还有一堆折腾完觉得值得留档的东西。
      </p>
    </section>

    <section class="panel">
      <h2>🧭 我做的站</h2>
      <p>都在同一个域名下，各管一摊事。</p>
      <ul class="site-links">
        {
          MY_SITES.map((site) => (
            <li>
              <a
                class:list={['site-link', { current: site.current }]}
                href={site.current ? '/' : site.url}
                target={site.current ? undefined : '_blank'}
                rel={site.current ? undefined : 'noopener noreferrer'}
                aria-current={site.current ? 'page' : undefined}
              >
                <span class="site-link__badge">{site.badge}</span>
                <span class="site-link__text">
                  <b>{site.name}</b>
                  <em>{site.desc}</em>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="panel">
      <h2>📮 找到我</h2>
      <p>有事直接说，不用寒暄。</p>
      <div class="contact-row">
        {
          contacts.map((item) => (
            <a class="btn btn--ghost" href={item.href} rel={item.href.startsWith('http') ? 'noopener' : undefined} target={item.href.startsWith('http') ? '_blank' : undefined}>
              <span aria-hidden="true">{item.emoji}</span> {item.label}
              <span class="contact-hint">{item.hint}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="panel">
      <h2>🧱 站点是怎么搭的</h2>
      <p>全部按官方文档的推荐方式落地，没有自建框架层。</p>
      <div class="tag-grid" style="margin-top:16px">
        {
          stack.map((item) => (
            <div class="tag-card" style="cursor:default">
              <span>{item.emoji} {item.layer}</span>
              <b style="font-size:12.5px;font-weight:500;color:var(--muted)">{item.value}</b>
            </div>
          ))
        }
      </div>
    </section>

    <section class="panel">
      <h2>💬 留言</h2>
      <p>
        站内留言直接在任意文章底部写，支持一张 2MB 以内的配图。
      </p>
    </section>
  </div>
</BaseLayout>
