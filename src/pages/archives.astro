---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPosts, postPath } from '../lib/posts';

const posts = await getPosts();

const byYear = posts.reduce<Map<number, typeof posts>>((map, post) => {
  const year = post.data.pubDate.getFullYear();
  const bucket = map.get(year) ?? [];
  bucket.push(post);
  map.set(year, bucket);
  return map;
}, new Map());

const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<BaseLayout title="归档" description="按年份浏览樱云小筑的全部笔记">
  <div class="wrap page" style="padding-top: calc(var(--nav-h) + 40px)">
    <div class="ch-head" style="margin-top:0">
      <span class="ch-badge" aria-hidden="true">🗂️</span>
      <h1 class="ch-title">归档</h1>
      <span class="ch-line"></span>
      <span class="ch-more">{posts.length} 篇 · {years.length} 个年份</span>
    </div>

    {
      years.map(([year, items]) => (
        <section class="archive-year" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>
            {year} <span style="font-size:14px;color:var(--muted)">{items.length} 篇</span>
          </h2>
          <ul class="archive-list">
            {items.map((post) => (
              <li class="archive-item">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate).slice(5)}
                </time>
                <a href={postPath(post)}>
                  {post.data.emoji} {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
