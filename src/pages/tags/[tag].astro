---
export const prerender = true;

import TagPostsPage from '../../components/pages/TagPostsPage.astro';
import { getPosts, tagCounts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts('zh');
  return tagCounts(posts).map(({ tag }) => ({ params: { tag } }));
}

const tag = Astro.params.tag ?? '';
const posts = await getPosts('zh');
const matched = posts.filter((post) => post.data.tags.includes(tag));
---

<TagPostsPage lang="zh" tag={tag} posts={matched} />
