---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SakuraBackdrop from '../components/SakuraBackdrop.astro';
import { SITE } from '../config';
import {
  LANG_HTML,
  LANG_OG_LOCALE,
  alternatePath,
  langFromPath,
  t,
} from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  fullTitle?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  fullTitle = false,
  ogType = 'website',
  ogImage = '/images/og-default.png',
  noindex = false,
  jsonLd,
} = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const strings = t(lang);
const pageTitle = fullTitle ? title : `${title} · ${SITE.name}`;
const pageDescription = description ?? strings.meta.description(SITE.name);
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.url).href;
const alternates = [
  { lang: 'zh-CN', path: alternatePath(Astro.url.pathname, 'zh') },
  { lang: 'en', path: alternatePath(Astro.url.pathname, 'en') },
];
---

<!doctype html>
<html lang={LANG_HTML[lang]} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((item) => (
        <link rel="alternate" hreflang={item.lang} href={new URL(item.path, Astro.site ?? SITE.url).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(alternatePath(Astro.url.pathname, 'zh'), Astro.site ?? SITE.url).href} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE.author} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LANG_OG_LOCALE[lang]} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content={SITE.themeColor.light} media="(prefers-color-scheme: light)" data-theme-color />
    <meta name="theme-color" content={SITE.themeColor.dark} media="(prefers-color-scheme: dark)" data-theme-color />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={lang === 'en' ? '/en/rss.xml' : '/rss.xml'} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('sakura-note-theme');
          var theme = saved === 'light' || saved === 'dark'
            ? saved
            : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
          var color = theme === 'dark' ? '#241b3a' : '#ffd7e9';
          var metas = document.querySelectorAll('meta[data-theme-color]');
          for (var i = 0; i < metas.length; i += 1) metas[i].setAttribute('content', color);
          var icon = document.getElementById('theme-icon');
          if (icon) icon.textContent = theme === 'dark' ? '☀️' : '🌙';
        } catch (error) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{strings.nav.skipToContent}</a>

    <SakuraBackdrop />
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <button class="backtop" id="backtop" type="button" aria-label={strings.nav.backTop}>🌸</button>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
