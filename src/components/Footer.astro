---
import { SITE, SOCIAL } from '../config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__big">🌸 {SITE.name} · {SITE.nameEn} 🌸</div>
  <p class="site-footer__row">
    {SITE.tagline} · © {year} {SITE.author}
  </p>
  <p class="site-footer__row">
    Astro 7 × Cloudflare Workers · 内容构建期生成，交互走边缘
  </p>
  <nav class="site-footer__links" aria-label="站外链接">
    {SOCIAL.map((item) => (
      <a href={item.href} rel={item.href.startsWith('http') ? 'noopener' : undefined}>
        <span aria-hidden="true">{item.emoji}</span> {item.label}
      </a>
    ))}
  </nav>
</footer>
