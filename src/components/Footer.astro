---
import { SITE, SOCIAL } from '../config';
import { langFromPath, localizePath, t } from '../lib/i18n';

const lang = langFromPath(Astro.url.pathname);
const strings = t(lang);
const year = new Date().getFullYear();
const yearRange = year === SITE.since ? `${year}` : `${SITE.since}-${year}`;
---

<footer class="site-footer">
  <div class="site-footer__big">🌸 {SITE.name} · {SITE.theme} 🌸</div>
  <p class="site-footer__row">{strings.hero.subtitle}</p>
  <p class="site-footer__row">
    © {yearRange} {SITE.author}
    · {strings.footer.builtWith}
    <a href="https://astro.build/" rel="noopener">Astro</a>
    {strings.footer.builtWithTail} · {strings.footer.hostedOn}
    <a href="https://www.cloudflare.com/" rel="noopener">Cloudflare</a>
    · {strings.footer.themeCredit(SITE.theme)}
  </p>
  <nav class="site-footer__links" aria-label={strings.footer.nav}>
    {
      SOCIAL.map((item) => (
        <a
          href={item.href.startsWith('/') ? localizePath(lang, item.href) : item.href}
          rel={item.href.startsWith('http') ? 'noopener' : undefined}
        >
          <span aria-hidden="true">{item.emoji}</span> {item.label}
        </a>
      ))
    }
  </nav>
</footer>
