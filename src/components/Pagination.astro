---
interface Props {
  current: number;
  totalPages: number;
}

const { current, totalPages } = Astro.props;

const hrefFor = (page: number) => (page <= 1 ? '/' : `/page/${page}`);
---

{
  totalPages > 1 && (
    <nav class="pager" aria-label="分页">
      {current > 1 ? (
        <a class="btn" href={hrefFor(current - 1)} data-astro-prefetch>
          ← 上一页
        </a>
      ) : (
        <span class="btn" aria-disabled="true" style="opacity:.45">← 上一页</span>
      )}

      <span class="pager__info">
        第 {current} / {totalPages} 页
      </span>

      {current < totalPages ? (
        <a class="btn" href={hrefFor(current + 1)} data-astro-prefetch>
          下一页 →
        </a>
      ) : (
        <span class="btn" aria-disabled="true" style="opacity:.45">下一页 →</span>
      )}
    </nav>
  )
}
