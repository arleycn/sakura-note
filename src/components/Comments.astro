---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import { langFromPath, t } from '../lib/i18n';

interface Props {
  postId: string;
}

const { postId } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const strings = t(lang).comments;
const turnstileKey = PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<section class="comments" id="comments" aria-labelledby="comments-title">
  <div class="ch-head">
    <span class="ch-badge" aria-hidden="true">💌</span>
    <h2 class="ch-title" id="comments-title">{strings.title}</h2>
    <span class="ch-line"></span>
    <span class="ch-more" id="comment-count" aria-live="polite"></span>
  </div>

  <form class="comment-form" id="comment-form" data-post-id={postId} novalidate>
    <input type="hidden" name="postId" value={postId} />

    <div class="hp" aria-hidden="true">
      <label for="comment-website">{strings.website}</label>
      <input id="comment-website" type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field">
      <label for="comment-author">{strings.nickname}</label>
      <input
        id="comment-author"
        type="text"
        name="author"
        maxlength="24"
        required
        autocomplete="nickname"
        placeholder={strings.nicknamePlaceholder}
      />
    </div>

    <div class="field">
      <label for="comment-body">{strings.body}</label>
      <textarea
        id="comment-body"
        name="body"
        maxlength="600"
        required
        placeholder={strings.bodyPlaceholder}
      ></textarea>
    </div>

    <div class="field">
      <label for="comment-image">{strings.image}</label>
      <input id="comment-image" type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" />
    </div>

    {
      turnstileKey && (
        <div class="field">
          <div class="cf-turnstile" id="turnstile-slot" data-sitekey={turnstileKey}></div>
        </div>
      )
    }

    <div class="form-row">
      <p class="form-status" id="comment-status" role="status" aria-live="polite"></p>
      <button class="btn btn--primary" type="submit" id="comment-submit">
        {strings.submit} ✉️
      </button>
    </div>
  </form>

  <noscript>
    <p class="comments__empty">{strings.noscript}</p>
  </noscript>

  <div class="comment-list" id="comment-list"></div>
  <p class="comments__empty" id="comment-empty" hidden>{strings.empty}</p>
</section>

{
  turnstileKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer />
  )
}
