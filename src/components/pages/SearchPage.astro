---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../PostCard.astro';
import { localizePath, t, type Lang } from '../../lib/i18n';
import type { Post } from '../../lib/posts';

interface Props {
  lang: Lang;
  query: string;
  results: Post[];
}

const { lang, query, results } = Astro.props;
const strings = t(lang);
const searchAction = localizePath(lang, '/search');
---

<BaseLayout
  title={query ? strings.search.titleFor(query) : strings.search.title}
  description={strings.search.description}
  noindex
>
  <div class="wrap page" style="padding-top: calc(var(--nav-h) + 40px); max-width: 880px">
    <div class="ch-head" style="margin-top:0">
      <span class="ch-badge" aria-hidden="true">🔍</span>
      <h1 class="ch-title">{strings.search.title}</h1>
      <span class="ch-line"></span>
    </div>

    <form class="search-form" method="get" action={searchAction} role="search">
      <label for="q" class="hp">{strings.search.label}</label>
      <input
        id="q"
        type="search"
        name="q"
        value={query}
        placeholder={strings.search.placeholder}
        autocomplete="off"
        autofocus
      />
      <button class="btn btn--primary" type="submit">{strings.search.submit} 🔍</button>
    </form>

    {
      query && (
        <p class="ch-more" style="margin-top:18px">
          {strings.search.resultFor(query, results.length)}
        </p>
      )
    }

    <div class="posts" style="margin-top:20px">
      {results.map((post) => <PostCard post={post} />)}
    </div>

    {
      query && results.length === 0 && (
        <p class="comments__empty">
          {strings.search.none}
          <a href={localizePath(lang, '/archives')}>{strings.search.noneArchive}</a>
          {strings.search.noneTail}
        </p>
      )
    }

    {
      !query && (
        <p class="comments__empty">
          {strings.search.hint} {strings.search.noindexHint}
        </p>
      )
    }
  </div>
</BaseLayout>
