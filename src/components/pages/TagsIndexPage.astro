---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config';
import { t, type Lang } from '../../lib/i18n';
import { tagPath, tagCounts, type Post } from '../../lib/posts';

interface Props {
  lang: Lang;
  posts: Post[];
}

const { lang, posts } = Astro.props;
const strings = t(lang);
const tags = tagCounts(posts);
---

<BaseLayout title={strings.tags.title} description={strings.tags.description(SITE.name)}>
  <div class="wrap page" style="padding-top: calc(var(--nav-h) + 40px)">
    <div class="ch-head" style="margin-top:0">
      <span class="ch-badge" aria-hidden="true">🏷️</span>
      <h1 class="ch-title">{strings.tags.title}</h1>
      <span class="ch-line"></span>
      <span class="ch-more">{strings.tags.summary(tags.length)}</span>
    </div>

    <div class="tag-grid">
      {
        tags.map(({ tag, count }) => (
          <a class="tag-card" href={tagPath(tag, lang)}>
            <span>#{tag}</span>
            <b>{count}</b>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
