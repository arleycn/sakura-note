---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../PostCard.astro';
import { localizePath, t, type Lang } from '../../lib/i18n';
import type { Post } from '../../lib/posts';

interface Props {
  lang: Lang;
  tag: string;
  posts: Post[];
}

const { lang, tag, posts } = Astro.props;
const strings = t(lang);
---

<BaseLayout title={`#${tag}`} description={strings.tags.tagDescription(tag)}>
  <div class="wrap page" style="padding-top: calc(var(--nav-h) + 40px)">
    <div class="ch-head" style="margin-top:0">
      <span class="ch-badge" aria-hidden="true">🏷️</span>
      <h1 class="ch-title">#{tag}</h1>
      <span class="ch-line"></span>
      <a class="ch-more" href={localizePath(lang, '/tags')}>{strings.common.allTags}</a>
    </div>

    <div class="posts">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    {posts.length === 0 && <p class="comments__empty">{strings.tags.empty}</p>}
  </div>
</BaseLayout>
