---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MY_SITES, SITE } from '../../config';
import { langFromPath, localizePath, t } from '../../lib/i18n';

const lang = langFromPath(Astro.url.pathname);
const strings = t(lang).about;
const nav = t(lang).nav;

const contacts = [
  { label: 'GitHub', hint: 'GitHub', href: SITE.github, emoji: '🐙' },
  { label: 'Email', hint: SITE.email, href: `mailto:${SITE.email}`, emoji: '📮' },
  { label: nav.source, hint: 'Source', href: SITE.repo, emoji: '🧩' },
];
---

<BaseLayout title={strings.title} description={strings.description(SITE.author)}>
  <div class="wrap page about" style="padding-top: calc(var(--nav-h) + 40px); max-width: 880px">
    <div class="ch-head" style="margin-top:0">
      <span class="ch-badge" aria-hidden="true">🍡</span>
      <h1 class="ch-title">{strings.title}</h1>
      <span class="ch-line"></span>
    </div>

    <section class="panel about-me">
      <img
        class="about-avatar"
        src="/images/avatar.svg"
        alt={strings.avatarAlt(SITE.author)}
        width="88"
        height="88"
        loading="eager"
        decoding="async"
      />
      <div>
        <p class="about-name">{SITE.author}</p>
        <p class="about-tag">{strings.role}</p>
      </div>
    </section>

    <section class="panel">
      <h2>🌸 {strings.where}</h2>
      <p>{strings.whereText(SITE.name, SITE.theme, SITE.since)}</p>
    </section>

    <section class="panel">
      <h2>🧭 {strings.sites}</h2>
      <p>{strings.sitesDesc}</p>
      <ul class="site-links">
        {
          MY_SITES.map((site) => (
            <li>
              <a
                class:list={['site-link', { current: site.current }]}
                href={site.current ? localizePath(lang, '/') : site.url}
                target={site.current ? undefined : '_blank'}
                rel={site.current ? undefined : 'noopener noreferrer'}
                aria-current={site.current ? 'page' : undefined}
              >
                <span class="site-link__badge">{site.badge[lang]}</span>
                <span class="site-link__text">
                  <b>{site.name}</b>
                  <em>{site.desc[lang]}</em>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="panel">
      <h2>📮 {strings.find}</h2>
      <p>{strings.findDesc}</p>
      <div class="contact-row">
        {
          contacts.map((item) => (
            <a class="btn btn--ghost" href={item.href} rel={item.href.startsWith('http') ? 'noopener' : undefined} target={item.href.startsWith('http') ? '_blank' : undefined}>
              <span aria-hidden="true">{item.emoji}</span> {item.label}
              <span class="contact-hint">{item.hint}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="panel">
      <h2>🧱 {strings.stack}</h2>
      <p>{strings.stackDesc}</p>
      <div class="tag-grid" style="margin-top:16px">
        {
          strings.stackItems.map((item) => (
            <div class="tag-card" style="cursor:default">
              <span>{item.emoji} {item.layer}</span>
              <b style="font-size:12.5px;font-weight:500;color:var(--muted)">{item.value}</b>
            </div>
          ))
        }
      </div>
    </section>

    <section class="panel">
      <h2>💬 {strings.guestbook}</h2>
      <p>{strings.guestbookDesc}</p>
    </section>
  </div>
</BaseLayout>
